# CreatorAi Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas URI (or leave blank to auto-use in-memory Mongo for instant zero-config testing)
MONGODB_URI=

# Authentication Secret
JWT_SECRET=creatorai_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Local File Storage
UPLOAD_DIR=./uploads
